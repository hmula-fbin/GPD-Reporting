{
  "permissions": {
    "allow": [
      "Bash(node build/build.mjs:*)",
      "Bash(npm test:*)",
      "Bash(npm run build:*)",
      "Bash(npm install)",
      "Bash(npx playwright test:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git fetch:*)",
      "Bash(git branch:*)",
      "Bash(git switch:*)",
      "Bash(git pull origin main)",
      "Bash(node tools/package.mjs --env dev:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git commit:*)",
      "Bash(git merge:*)",
      "Bash(git tag:*)",
      "Bash(pwsh -NoProfile -ExecutionPolicy Bypass -File deploy/Deploy-Portfolio.ps1 -Env dev:*)",
      "Bash(node tools/package.mjs --env prod:*)"
    ],
    "deny": [
      "Bash(*Deploy-Portfolio.ps1*prod*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Read(data/**)",
      "Edit(dist/**)",
      "Edit(src/vendor/**)"
    ]
  }
}
