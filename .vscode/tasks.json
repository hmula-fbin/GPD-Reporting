{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Get latest from team",
      "type": "shell",
      "command": "git fetch origin --prune --tags; git switch main; git pull origin main; npm install",
      "problemMatcher": []
    },
    {
      "label": "Build: dev",
      "type": "shell",
      "command": "node build/build.mjs --env dev",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Build: all environments",
      "type": "shell",
      "command": "node build/build.mjs --env all",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Preview (dev, fixture data)",
      "type": "shell",
      "command": "npm run preview",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Preview (dev, real extract in data/)",
      "type": "shell",
      "command": "node build/build.mjs --env dev && node tools/serve.mjs --env dev --data \"data/Pipeline Data.xlsx\"",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Test",
      "type": "shell",
      "command": "npm test",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Upload: package Dev pages",
      "type": "shell",
      "command": "node tools/package.mjs --env dev",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "focus": true
      }
    },
    {
      "label": "Upload: package Prod pages (release owner)",
      "type": "shell",
      "command": "node tools/package.mjs --env prod",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "focus": true
      }
    },
    {
      "label": "Deploy: dev (automatic, needs PnP app)",
      "type": "shell",
      "command": "pwsh -NoProfile -ExecutionPolicy Bypass -File deploy/Deploy-Portfolio.ps1 -Env dev",
      "problemMatcher": []
    },
    {
      "label": "Deploy: prod (automatic, needs PnP app)",
      "type": "shell",
      "command": "pwsh -NoProfile -ExecutionPolicy Bypass -File deploy/Deploy-Portfolio.ps1 -Env prod",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "focus": true
      }
    }
  ]
}
